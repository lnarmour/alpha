{
  "name": "alpha-language",
  "displayName": "Alpha Language",
  "description": "Syntax highlighting and live diagnostics for the Alpha polyhedral language (.alpha), backed by alpha-rs's alpha-syntax/alpha-model front end.",
  "version": "0.4.0",
  "publisher": "lnarmour",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lnarmour/alpha.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:alpha"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "alpha",
        "aliases": [
          "Alpha",
          "alpha"
        ],
        "extensions": [
          ".alpha"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "alpha",
        "scopeName": "source.alpha",
        "path": "./syntaxes/alpha.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:native": "npm --prefix native install && npm --prefix native run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
