// Evaluate every statement, in schedule order.
	long c0;
	long c2;
	for (c0 = 0; c0 < N; c0 += 1) {
		{
			long i = c0;
			Y(i) = 0.0f;
		}
		for (c2 = 0; c2 <= c0; c2 += 1) {
			{
				long i = c0;
				long j = c2;
				Y(i) = (Y(i)) + (((i >= 1 && N >= i + 1 && j == i) || (N >= i + 1 && i >= 0 && j == i)) ? (((X(j)) + (X(j)))) : (X(j)));
			}
		}
	}
