// Evaluate every statement, in schedule order.
	long c0;
	long c2;
	for (c0 = 0; c0 < N; c0 += 1) {
		{
			long i = c0;
			Y(i) = 0.0f;
		}
		for (c2 = N - c0 - 1; c2 < N; c2 += 1) {
			{
				long i = c0;
				long j = N - c2 - 1;
				Y(i) = (Y(i)) + (X(j));
			}
		}
	}
