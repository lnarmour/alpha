{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "packages": {
    "editors/vscode": {
      "release-type": "node",
      "component": "alpha-vscode",
      "include-component-in-tag": true
    },
    "alphalang": {
      "release-type": "python",
      "component": "alphalang",
      "include-component-in-tag": true,
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  }
}
